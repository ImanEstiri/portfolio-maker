<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure domain. No I/O, no ASP.NET, no database, no HTTP client.

    Template binding and LaTeX escaping live here because a bug in either is
    the difference between a broken PDF and a security incident, and this
    project's tests run in milliseconds. Keep it that way: if something here
    needs a connection string, it belongs in CvMaker.Api instead.
  -->

  <ItemGroup>
    <!--
      7.x, not 5.x: every 5.x release carries NU1903 advisories, including an
      unauthenticated OutOfMemoryException crash via unbounded string.pad_left /
      pad_right (GHSA-v66j-x4hw-fv9g), fixed in 7.0.0.

      Our templates are repo-owned, so a template calling pad_left with a hostile
      width is not a path an attacker controls today — but this package sits
      inside the escaping boundary, and shipping a component with four known
      high-severity advisories to save an upgrade is not a trade worth making.
      Keep this current, and treat a new NU1903 here as a release blocker.
    -->
    <PackageReference Include="Scriban" Version="7.2.6" />
  </ItemGroup>

</Project>
