@page "/reset-password"
@inject AuthClient Auth
@inject NavigationManager Nav

<PageTitle>Set a new password</PageTitle>
<h1>Set a new password</h1>

@if (_done)
{
    <p class="notice" role="status">
        Your password is set, and every other session has been signed out. Sign in with the
        new one.
    </p>
    <p><a href="login">Go to sign in</a></p>
}
else if (string.IsNullOrWhiteSpace(Token) || string.IsNullOrWhiteSpace(Email))
{
    <p class="error" role="alert">
        This link is missing part of itself. Some mail clients break long links across lines —
        try copying the whole thing into the address bar, or
        <a href="forgot-password">request a new one</a>.
    </p>
}
else
{
    <EditForm Model="@_model" OnValidSubmit="@SubmitAsync">
        <label>
            New password
            <InputText @bind-Value="_model.Password" type="password" autocomplete="new-password" />
        </label>
        <label>
            Confirm new password
            <InputText @bind-Value="_model.Confirm" type="password" autocomplete="new-password" />
        </label>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <button type="submit" disabled="@_busy">@(_busy ? "Saving…" : "Set password")</button>
    </EditForm>
}

@code {
    private sealed class Model
    {
        public string Password { get; set; } = string.Empty;
        public string Confirm { get; set; } = string.Empty;
    }

    private readonly Model _model = new();
    private string? _error;
    private bool _busy;
    private bool _done;

    /// <summary>Both come from the emailed link.</summary>
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private async Task SubmitAsync()
    {
        _error = null;

        if (_model.Password != _model.Confirm)
        {
            _error = "The two passwords do not match.";
            return;
        }

        _busy = true;
        _error = await Auth.ResetPasswordAsync(Email!, Token!, _model.Password);
        _busy = false;

        _done = _error is null;
    }
}
