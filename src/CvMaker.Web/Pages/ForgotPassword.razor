@page "/forgot-password"
@inject AuthClient Auth

<PageTitle>Reset your password</PageTitle>
<h1>Reset your password</h1>

@if (_sent)
{
    @* Deliberately the same message whether or not the address exists. Anything that
       distinguishes the two turns this form into an account-enumeration oracle, and this
       service holds CVs — knowing who has an account is itself worth something. *@
    <p class="notice" role="status">
        If there is an account for that address, a reset link is on its way. The link expires,
        so use it soon.
    </p>
    <p><a href="login">Back to sign in</a></p>
}
else
{
    <p>
        Enter the address you signed up with and we will send a link to set a new password.
    </p>

    <EditForm Model="@_model" OnValidSubmit="@SubmitAsync">
        <label>
            Email
            <InputText @bind-Value="_model.Email" type="email" autocomplete="username" />
        </label>

        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }

        <button type="submit" disabled="@_busy">@(_busy ? "Sending…" : "Send the link")</button>
    </EditForm>

    <p><a href="login">Back to sign in</a></p>
}

@code {
    // A service holding CVs cannot lock people out permanently, which is what "sign-in form
    // and nothing else" amounted to.

    private sealed class Model
    {
        public string Email { get; set; } = string.Empty;
    }

    private readonly Model _model = new();
    private string? _error;
    private bool _busy;
    private bool _sent;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        // Only a transport failure comes back here. A rejected address does not, on purpose.
        _error = await Auth.ForgotPasswordAsync(_model.Email);

        _busy = false;
        _sent = _error is null;
    }
}
